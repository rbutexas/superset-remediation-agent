# Copy to ~/.devin.env (chmod 600). Never commit a filled-in copy —
# .gitignore already covers .env, .env.* and *.env.

# Devin service-user key. Settings -> Service users -> Generate API key.
DEVIN_API_KEY=cog_...

# Settings -> Service Users.
DEVIN_ORG_ID=org-...

# Fine-grained GitHub PAT. Five permissions, scoped to the fork:
#   Metadata:R  Issues:RW  Contents:RW  Pull requests:RW  Actions:R
# Deliberately NOT Administration, Workflows or Secrets — the credential that
# drives an autonomous loop should not be able to reconfigure the repository.
GITHUB_TOKEN=github_pat_...

# --- optional ---------------------------------------------------------------
TARGET_REPO=rbutexas/superset
MAX_ACU_PER_SESSION=25        # hard per-session cap, enforced by Devin
MAX_CONCURRENT_SESSIONS=3     # ours; Devin imposes no concurrency limit
POLL_INTERVAL_SECONDS=60
DB_PATH=data/agent.db
